# Postgres connection string. Works with Supabase, Neon, or Vercel Postgres (all have free tiers).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Any long random string. Protects the /api/scrape endpoint used by the cron job.
CRON_SECRET="change-me-to-a-long-random-string"
